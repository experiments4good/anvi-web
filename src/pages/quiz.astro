---
import '../styles/guides.css';
import '../styles/result.css';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import AppStoreBadge from '../components/AppStoreBadge.astro';
import Glyph from '../components/Glyph.astro';
import { CORE } from '../lib/core';

const title = 'Free Dosha Quiz | Anvi';
const description = "Anvi's 20-question dosha quiz, free and with no sign-up. Your answers stay in your browser.";

// For the result, by guide slug: the type's core advice (the guide cards'
// line) and its "Start this week" lines, word for word from its guide.
const guides = Object.fromEntries((await getCollection('guides')).map((g) => [g.data.slug, { core: CORE[g.data.slug], week: g.data.week }]));
---

<Base title={title} description={description}>
  <section class="quiz page">
    <!-- Intro. The line under the heading is the App Store description's quiz sentence. -->
    <div id="intro" class="quiz-intro">
      <Glyph scores={[4, 4, 4]} id="intro-glyph" settle />
      <h1>Discover your dosha</h1>
      <p class="lead">Twenty questions about your body, digestion, skin and hair, sleep, energy, temperament, and stress.</p>
      <button class="btn btn-primary" id="start" type="button">Start quiz</button>
      <p class="disclaimer">This quiz is for educational purposes only and does not constitute medical advice.</p>
      <noscript><p class="lead">The quiz runs in your browser and needs JavaScript turned on.</p></noscript>
    </div>

    <!-- One question at a time, as in the app. -->
    <div id="ask" hidden>
      <div class="progress">
        <p class="progress-text" id="progress-text" aria-live="polite"></p>
        <div class="progress-bar" aria-hidden="true"><span id="progress-fill"></span></div>
      </div>
      <h1 class="question" id="question" tabindex="-1"></h1>
      <p class="hint" id="hint"></p>
      <div class="options" id="options"></div>
      <button class="back" id="back" type="button">Back</button>
    </div>

  </section>

  <!-- The result, as the approved mockup (Result): the visitor's own glyph,
       the type, its core advice and today's focus, the percentages as bars,
       three lines to start with from the type's guide, and the app. -->
  <div id="result" class="result r" hidden>
    <section class="r-top">
      <div class="r-wrap r-top-grid">
        <div class="r-glyph"><span class="glyph-disc" id="result-glyph"></span></div>
        <div>
          <p class="result-label">Your dosha</p>
          <h1 class="result-name" id="result-name" tabindex="-1"></h1>
          <p class="r-core" id="result-core"></p>
          <p class="r-now" id="preview" hidden></p>
          <div class="r-actions">
            <a class="r-btn" id="guide-link" href="/">Read your guide</a>
            <button class="r-btn r-share btn-share" id="share" type="button">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3v12M7 8l5-5 5 5M5 14v6h14v-6"></path></svg>
              Share
            </button>
          </div>
          <p class="share-note" id="share-note" aria-live="polite" hidden></p>
        </div>
      </div>
    </section>

    <section class="r-wrap r-breakdown" aria-labelledby="breakdown-title">
      <h2 id="breakdown-title">Your constitution breakdown</h2>
      <div class="r-bars" id="rows"></div>
    </section>

    <section class="r-week" aria-labelledby="week-title">
      <div class="r-wrap">
        <h2 id="week-title">Start this week</h2>
        <div class="r-cards" id="week"></div>
        <a class="r-week-link" id="week-link" href="/">See your full guide</a>
      </div>
    </section>

    <section class="r-wrap r-end">
      <div class="r-app">
        <h2>Get your daily routine, tips and menu help in the Anvi app</h2>
        <AppStoreBadge />
      </div>
      <p class="disclaimer">This quiz is for educational purposes only and does not constitute medical advice.</p>
      <button class="r-retake" id="retake" type="button">Retake the quiz</button>
    </section>
  </div>
  <script type="application/json" id="guide-data" set:html={JSON.stringify(guides)} />
</Base>

<script>
  // The whole quiz runs here. No network calls, no cookies, no storage: the
  // answers live in this page's memory and are gone when it closes.
  import { glyphSvg } from '../lib/glyph';
  import { QUIZ } from '../lib/quiz';
  import { breakdown, guidePath, resultLabel, scoresFor } from '../lib/scoring';
  import { balancedFor, focusNow, seasonForDate, type Pair } from '../lib/windows';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const intro = $('intro');
  const ask = $('ask');
  const result = $('result');
  type Week = { food: string; mind: string | null; wake: Record<string, string> };
  const guides = JSON.parse($('guide-data').textContent ?? '{}') as Record<string, { core: string; week: Week }>;
  const PAIR: Record<string, Pair> = {
    'Vata-Pitta': 'vata-pitta',
    'Pitta-Vata': 'vata-pitta',
    'Vata-Kapha': 'vata-kapha',
    'Kapha-Vata': 'vata-kapha',
    'Pitta-Kapha': 'pitta-kapha',
    'Kapha-Pitta': 'pitta-kapha',
  };
  // The app's share message (src/lib/share.ts), linking to this quiz.
  const QUIZ_URL = 'https://getanvi.app/quiz/';
  const shareText = (dosha: string) => `My dosha is ${dosha}, according to Anvi, an Ayurvedic companion app. Find yours: ${QUIZ_URL}`;

  /** Answer indexes, one per question; -1 while unanswered. */
  let answers: number[] = [];
  /** Each question's display order, shuffled once per run as the app does per screen. */
  let orders: number[][] = [];
  let current = 0;
  let label = '';

  function shuffled(): number[] {
    const a = [0, 1, 2];
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j]!, a[i]!];
    }
    return a;
  }

  function show(view: HTMLElement) {
    for (const v of [intro, ask, result]) v.hidden = v !== view;
    // The result has its own full-width bands; the quiz column steps aside.
    (document.querySelector('section.quiz') as HTMLElement).hidden = view === result;
    window.scrollTo(0, 0);
  }

  function renderQuestion() {
    const q = QUIZ[current]!;
    $('progress-text').textContent = `Question ${current + 1} of ${QUIZ.length}`;
    $('progress-fill').style.width = `${((current + 1) / QUIZ.length) * 100}%`;
    $('question').textContent = q.question;
    $('hint').textContent = q.hint;
    $('options').replaceChildren(
      ...orders[current]!.map((i) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'option';
        b.textContent = q.answers[i]!;
        b.setAttribute('aria-pressed', String(answers[current] === i));
        b.addEventListener('click', () => choose(i));
        return b;
      }),
    );
    show(ask);
    $('question').focus({ preventScroll: true });
  }

  function choose(i: number) {
    answers[current] = i;
    if (current < QUIZ.length - 1) {
      current++;
      renderQuestion();
    } else {
      renderResult();
    }
  }

  function renderResult() {
    const scores = scoresFor(answers);
    label = resultLabel(scores);
    $('result-glyph').innerHTML = glyphSvg([scores.vata, scores.pitta, scores.kapha], { id: 'result-glyph-svg', settle: true });
    // A non-breaking hyphen, so a two-dosha name never splits across lines.
    $('result-name').textContent = label.replace('-', '\u2011');
    // The percentages as labelled bars in the glyph's colors, largest first.
    $('rows').replaceChildren(
      ...breakdown(scores).map(({ dosha, percent }) => {
        const row = document.createElement('div');
        row.className = `r-bar is-${dosha.toLowerCase()}`;
        const head = document.createElement('div');
        head.className = 'r-bar-head';
        const name = document.createElement('span');
        name.textContent = dosha;
        const pct = document.createElement('span');
        pct.textContent = `${percent}%`;
        head.append(name, pct);
        const track = document.createElement('div');
        track.className = 'r-track';
        const fill = document.createElement('div');
        fill.className = 'r-fill';
        fill.style.width = `${percent}%`;
        track.append(fill);
        row.append(head, track);
        return row;
      }),
    );
    const path = guidePath(label);
    const slug = path.split('/')[2]!;
    const guide = guides[slug]!;
    $('result-core').textContent = guide.core;
    // Two-dosha types: "Right now: balancing Pitta, through Nov 1.", from the
    // guides' date windows.
    const pair = PAIR[label];
    const preview = $('preview');
    const today = new Date();
    if (pair) {
      const [dosha, end] = focusNow(pair, today);
      const lead = document.createElement('strong');
      lead.textContent = 'Right now:';
      preview.replaceChildren(lead, ` balancing ${dosha}, through ${end}.`);
      preview.hidden = false;
    } else {
      preview.hidden = true;
    }
    // "Start this week": the guide's first Food line, its Wake up line for the
    // dosha it balances today (Tridoshic: by the season), its first Mind and
    // mood line. Tridoshic's guide has no Mind and mood section.
    const focus = pair ? balancedFor(pair, today) : slug === 'tridoshic' ? seasonForDate(today) : slug;
    const card = (title: string, text: string, label?: string) => {
      const div = document.createElement('div');
      div.className = 'r-card';
      const h = document.createElement('h3');
      h.textContent = title;
      div.append(h);
      if (label) {
        const l = document.createElement('p');
        l.className = 'r-card-label';
        l.textContent = label;
        div.append(l);
      }
      const p = document.createElement('p');
      p.textContent = text;
      div.append(p);
      return div;
    };
    const cards = [card('Food', guide.week.food), card('Routine', guide.week.wake[focus]!, 'Wake up')];
    if (guide.week.mind) cards.push(card('Mind and mood', guide.week.mind));
    $('week').replaceChildren(...cards);
    $<HTMLAnchorElement>('week-link').href = path;
    $<HTMLAnchorElement>('guide-link').href = path;
    $('share-note').hidden = true;
    show(result);
    $('result-name').focus({ preventScroll: true });
  }

  function begin() {
    answers = QUIZ.map(() => -1);
    orders = QUIZ.map(() => shuffled());
    current = 0;
    renderQuestion();
  }
  $('start').addEventListener('click', begin);
  $('retake').addEventListener('click', begin);

  $('back').addEventListener('click', () => {
    if (current === 0) show(intro);
    else {
      current--;
      renderQuestion();
    }
  });

  // Share with the Web Share API where there is one; otherwise copy the link.
  $('share').addEventListener('click', async () => {
    const note = $('share-note');
    if (navigator.share) {
      try {
        await navigator.share({ text: shareText(label) });
      } catch {
        // Closing the share sheet is not an error worth showing.
      }
      return;
    }
    try {
      await navigator.clipboard.writeText(QUIZ_URL);
      note.textContent = 'Link copied.';
    } catch {
      note.textContent = `Copy this link: ${QUIZ_URL}`;
    }
    note.hidden = false;
  });
</script>
