---
import { getEntry, render } from 'astro:content';
import Legal from '../layouts/Legal.astro';

const entry = await getEntry('legal', 'delete-account');
if (!entry) throw new Error('src/content/legal/delete-account.md is missing');
const { Content } = await render(entry);
---

<Legal title={entry.data.title} description="How to delete your Anvi account, and what is deleted and kept." updated={entry.data.updated}>
  <Content />
</Legal>
