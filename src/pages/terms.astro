---
import { getEntry, render } from 'astro:content';
import Legal from '../layouts/Legal.astro';

const entry = await getEntry('legal', 'terms');
if (!entry) throw new Error('src/content/legal/terms.md is missing');
const { Content } = await render(entry);
---

<Legal title={entry.data.title} description={`Anvi's ${entry.data.title.toLowerCase()}.`} updated={entry.data.updated}>
  <Content />
</Legal>
