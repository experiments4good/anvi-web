---
import '../styles/guides.css';
import Base from '../layouts/Base.astro';
import AppStoreBadge from '../components/AppStoreBadge.astro';
import Glyph from '../components/Glyph.astro';
import GuideCards from '../components/GuideCards.astro';

const description = 'Anvi is an Ayurvedic wellness companion. Find your dosha and get daily guidance shaped to your body and the season.';

// "What Anvi does": two of the App Store screenshots, each with the App Store
// description's own words for that feature.
const features = [
  {
    title: 'Scan a menu',
    text: 'Anvi reads it, recommends two or three dishes that suit your dosha and says why, points out what to skip, and tells you what to ask for when you order, such as no cream or a milder version.',
    image: '/screens/scan-a-menu.jpg',
    alt: "Anvi's suggestions for a restaurant menu, in the app",
  },
  {
    title: 'Chat with Anvi',
    text: 'Ask about food, sleep, digestion, stress, and daily routine, and get answers in plain language that account for the dosha result you got.',
    image: '/screens/chat-with-anvi.jpg',
    alt: 'A conversation with Anvi about breakfast, in the app',
  },
];
---

<Base title="Anvi" description={description} bar={false}>
  <div class="page">
    <section class="home-hero">
      <Glyph scores={[4, 4, 4]} id="home-glyph" settle />
      <div>
        <h1>Anvi</h1>
        <p class="tagline">Your Ayurvedic wellness companion</p>
        <p class="about">Find your dosha, then get daily guidance shaped to your constitution and the season.</p>
        <AppStoreBadge />
      </div>
    </section>

    <section class="home-section" aria-labelledby="does-title">
      <h2 id="does-title">What Anvi does</h2>
      <ul class="features">
        {
          features.map((f) => (
            <li class="feature">
              <img src={f.image} alt={f.alt} width="598" height="1300" loading="lazy" decoding="async" />
              <div>
                <h3>{f.title}</h3>
                <p>{f.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <a class="btn btn-primary home-quiz" href="/quiz/">Take the free dosha quiz</a>

    <!-- "This season": the current season's page, by the app's month-based
         seasons on the visitor's own clock. Without JavaScript, all three. -->
    <nav class="home-season" aria-label="This season">
      <a class="season-link" id="season-now" href="/season/fall/" hidden>This season: Fall</a>
      <div class="season-all" id="season-all">
        <span class="season-all-label">This season</span>
        <a class="season-link is-vata" href="/season/fall/"><span class="dot dot-vata" aria-hidden="true"></span>Fall</a>
        <a class="season-link is-pitta" href="/season/summer/"><span class="dot dot-pitta" aria-hidden="true"></span>Summer</a>
        <a class="season-link is-kapha" href="/season/winter-spring/"><span class="dot dot-kapha" aria-hidden="true"></span>Winter and spring</a>
      </div>
    </nav>

    <section class="home-section" id="guides" aria-labelledby="guides-title">
      <h2 id="guides-title">Type guides</h2>
      <GuideCards idPrefix="card" />
      <nav class="home-more" aria-label="More guides">
        <a class="season-link" href="/six-tastes/">The six tastes</a>
        <a class="season-link" href="/routine/">Your daily routine</a>
      </nav>
    </section>
  </div>
</Base>

<script>
  import { seasonForDate } from '../lib/windows';

  const season = seasonForDate(new Date());
  const [page, name] = ({ vata: ['fall', 'Fall'], pitta: ['summer', 'Summer'], kapha: ['winter-spring', 'Winter and spring'] } as const)[season];
  const now = document.getElementById('season-now') as HTMLAnchorElement;
  now.href = `/season/${page}/`;
  now.textContent = `This season: ${name}`;
  now.classList.add(`is-${season}`);
  now.hidden = false;
  (document.getElementById('season-all') as HTMLElement).hidden = true;
</script>
