---
import '../styles/fonts.css';
import '../styles/site.css';
import Mark from '../components/Mark.astro';
import { IMAGE_HEIGHT, IMAGE_WIDTH, imageAlt, imagePath, sharePages } from '../lib/share';

interface Props {
  title: string;
  description: string;
  /**
   * Apple's Smart App Banner for the app. Off on the privacy policy and
   * terms, which are kept exactly as published.
   */
  appBanner?: boolean;
}

const { title, description, appBanner = true } = Astro.props;
const origin = Astro.site?.origin ?? Astro.url.origin;
const canonical = new URL(Astro.url.pathname, origin).href;
// The page's link-preview image (src/pages/og), drawn at build time.
const share = (await sharePages()).find((p) => p.path === Astro.url.pathname);
if (!share) throw new Error(`No share image for ${Astro.url.pathname}; add the page to src/lib/share.ts`);
const image = new URL(imagePath(share.path), origin).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#FAFAF8" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Anvi" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content={String(IMAGE_WIDTH)} />
    <meta property="og:image:height" content={String(IMAGE_HEIGHT)} />
    <meta property="og:image:alt" content={imageAlt(share)} />
    <meta name="twitter:card" content="summary_large_image" />
    {appBanner && <meta name="apple-itunes-app" content="app-id=6811624799" />}
    <link rel="preload" href="/fonts/PlayfairDisplay-SemiBold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Lato-Regular.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <header class="site-head">
      <div class="site-head-inner">
        <a class="site-logo" href="/" aria-label="Anvi home">
          <Mark />
          <span>Anvi</span>
        </a>
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Open menu" hidden>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
        </button>
        <nav class="site-nav" id="site-nav" aria-label="Main">
          <ul>
            <li><a href="/#guides">Guides</a></li>
            <li><a href="/six-tastes/">Six tastes</a></li>
            <li><a href="/routine/">Daily routine</a></li>
            <!-- Named and linked from the visitor's own clock, by the app's
                 month-based seasons; without JavaScript it stays hidden. -->
            <li id="nav-season" hidden><a href="/season/fall/">This season</a></li>
            <li><a class="nav-quiz" href="/quiz/">Take the quiz</a></li>
          </ul>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="foot">
      <div class="foot-inner">
        <nav aria-label="Legal">
          <a href="/privacy">Privacy</a>
          <a href="/terms">Terms</a>
          <a href="mailto:support@getanvi.app">support@getanvi.app</a>
        </nav>
        <p>&copy; 2026 Utopian Visions, LLC</p>
      </div>
    </footer>
    <script>
      import { seasonForDate } from '../lib/windows';
      import '../scripts/glyph-motion';

      // "This season: Fall", from the visitor's own clock.
      const [page, name] = ({ vata: ['fall', 'Fall'], pitta: ['summer', 'Summer'], kapha: ['winter-spring', 'Winter and spring'] } as const)[seasonForDate(new Date())];
      const item = document.getElementById('nav-season') as HTMLElement;
      const link = item.querySelector('a') as HTMLAnchorElement;
      link.href = `/season/${page}/`;
      link.textContent = `This season: ${name}`;
      item.hidden = false;

      // On a phone the links fold behind the menu button. Without
      // JavaScript the button stays hidden and the links show as a list.
      const head = document.querySelector('.site-head') as HTMLElement;
      const button = head.querySelector('.menu-btn') as HTMLButtonElement;
      const nav = document.getElementById('site-nav') as HTMLElement;
      head.classList.add('has-menu');
      // The header's height while closed, for in-page links (site.css
      // scroll-padding-top), kept current as the width changes.
      const measure = () => {
        if (!nav.classList.contains('open')) document.documentElement.style.setProperty('--head-h', `${head.offsetHeight}px`);
      };
      new ResizeObserver(measure).observe(head);
      button.hidden = false;
      const setOpen = (open: boolean) => {
        button.setAttribute('aria-expanded', String(open));
        button.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        nav.classList.toggle('open', open);
      };
      button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
      head.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && nav.classList.contains('open')) {
          setOpen(false);
          button.focus();
        }
      });
      nav.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) setOpen(false);
      });
    </script>
  </body>
</html>
