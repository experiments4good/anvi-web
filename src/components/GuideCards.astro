---
// The seven type guides as cards: each type's glyph, its name and its core
// advice, in the order the quiz names the types. Used on the home page, the
// six tastes page and the routine page.
import { getCollection } from 'astro:content';
import Glyph from './Glyph.astro';
import { CORE } from '../lib/core';

interface Props {
  /** Prefix for the glyph ids, unique on the page. */
  idPrefix: string;
  /** The home page's grid: four across on a computer, and room for a last card it adds. */
  home?: boolean;
}

const { idPrefix, home = false } = Astro.props;
const ORDER = ['vata', 'pitta', 'kapha', 'vata-pitta', 'vata-kapha', 'pitta-kapha', 'tridoshic'];
const guides = (await getCollection('guides')).sort((a, b) => ORDER.indexOf(a.data.slug) - ORDER.indexOf(b.data.slug));
// Non-breaking hyphens, so a two-dosha name never splits at the hyphen.
const nb = (s: string) => s.replace(/-/g, '‑');
---

<ul class:list={['guide-cards', { 'is-home': home }]}>
  {
    guides.map((g) => (
      <li class="guide-card">
        <a href={`/dosha/${g.data.slug}/`}>
          <Glyph type={g.data.type} id={`${idPrefix}-${g.data.slug}`} />
          <span>
            <strong>{nb(g.data.type)}</strong>
            <span class="first">{CORE[g.data.slug]}</span>
          </span>
        </a>
      </li>
    ))
  }
  <slot />
</ul>
